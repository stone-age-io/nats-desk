# Built app - regenerated by `make ui`. dist/.gitkeep is committed so the
# //go:embed directive in frontend/embed.go resolves on a fresh clone.
frontend/dist/*
!frontend/dist/.gitkeep

frontend/node_modules/

# Binaries and build output
/nats-desk
/nats-desk.exe
/dist/

# Coverage
coverage.out
coverage.html

# Windows leaves this behind when rebuilding over a running binary
*.exe~
